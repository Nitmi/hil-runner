{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedded-hil-runner:simulation-plan:v1",
  "type": "object",
  "required": [
    "schema_version",
    "runner_version",
    "execution_kind",
    "hardware_access",
    "physical_board_verified",
    "authorization_granted",
    "target_cleanup_verified",
    "component_processes_started",
    "native_validation_performed",
    "inputs",
    "package_files",
    "cases",
    "component_timeout_seconds",
    "retries",
    "python_runtime_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "embedded-hil-runner.simulation-plan.v1"
    },
    "runner_version": {
      "const": "0.11.0"
    },
    "execution_kind": {
      "const": "simulation"
    },
    "hardware_access": {
      "const": false
    },
    "physical_board_verified": {
      "const": false
    },
    "authorization_granted": {
      "const": false
    },
    "target_cleanup_verified": {
      "const": false
    },
    "component_processes_started": {
      "const": false
    },
    "native_validation_performed": {
      "const": false
    },
    "inputs": {
      "type": "object"
    },
    "package_files": {
      "type": "object",
      "oneOf": [
        {
          "minProperties": 13,
          "maxProperties": 13
        },
        {
          "minProperties": 16,
          "maxProperties": 16
        },
        {
          "minProperties": 18,
          "maxProperties": 18
        },
        {
          "minProperties": 20,
          "maxProperties": 20
        },
        {
          "minProperties": 21,
          "maxProperties": 21
        },
        {
          "minProperties": 24,
          "maxProperties": 24
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8
    },
    "component_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "retries": {
      "const": 0
    }
  }
}
