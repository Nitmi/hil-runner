{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedded-hil-runner:simulation-spec:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "python", "sim_runner_wheel", "cases", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "embedded-hil-runner.simulation-spec.v1"},
    "python": {"$ref": "#/$defs/input"}, "sim_runner_wheel": {"$ref": "#/$defs/input"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "cases": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "plan"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"}, "plan": {"$ref": "#/$defs/input"}}
    }}
  },
  "$defs": {"input": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
    "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }}
}
